<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:contentDescription="@string/widget_content_description"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_projection_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_phone_projection" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_live_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/widget_live_indicator"
                android:contentDescription="@string/widget_live"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_carplay_title"
                android:textColor="#FFE5EEF0"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_default_status"
            android:textColor="#FFB7C8CE"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@drawable/widget_action_background"
        android:gravity="center"
        android:minWidth="88dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_connect"
        android:textColor="#FF00382D"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>

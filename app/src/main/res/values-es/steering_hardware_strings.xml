<resources>
    <string name="steer_hw_title">Aprendizaje de botones de fábrica</string>
    <string name="steer_hw_scope">Asigna los botones compatibles a la unidad. Estas asignaciones pueden funcionar fuera de Cabin. El decodificador CAN puede elegir la acción antes de que Cabin la reciba.</string>
    <string name="steer_hw_disconnected">Servicio de botones desconectado.</string>
    <string name="steer_hw_ready">Respuesta de los botones conectada.</string>
    <string name="steer_hw_waiting">Esperando respuesta de los botones.</string>
    <string name="steer_hw_started">Aprendizaje iniciado. Sigue las instrucciones.</string>
    <string name="steer_hw_assigning">Asignación solicitada. Esperando confirmación del botón…</string>
    <string name="steer_hw_learned">Respuesta recibida. Finaliza y guarda cuando termines.</string>
    <string name="steer_hw_saved">Guardado solicitado. El servicio no confirma si la MCU lo guardó permanentemente. Prueba los botones al salir de esta pantalla.</string>
    <string name="steer_hw_cleared">Borrado solicitado. Esperando que la unidad actualice los valores.</string>
    <string name="steer_hw_timeout">Tiempo de aprendizaje agotado. Inícialo de nuevo si es necesario.</string>
    <string name="steer_hw_failed">Fallo del servicio de botones. Comprueba la conexión antes de reintentar.</string>

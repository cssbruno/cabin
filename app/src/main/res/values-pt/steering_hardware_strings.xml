    <string name="steer_hw_feedback">Mapeamentos informados</string>
    <string name="steer_hw_backup_note">Os backups do Cabin não contêm os mapeamentos da MCU. O aprendizado da central não pode ser restaurado de um backup do Cabin.</string>
    <string name="steer_hw_clear_detail">Apagar o aprendizado dos botões na central? Isso pode remover os mapeamentos imediatamente. Será necessário ensinar os botões novamente.</string>

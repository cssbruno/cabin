<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NETWORK_STACK" />
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" />
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Required by connectedDevice foreground service type on Android 14+ -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <!-- Cluster CarAppService draws into the host-provided render surface. Verified on
         the AAOS emulator: the Templates Host provisions a virtual display
         "virtual:zeno.carlink,<uid>,CarAppService,0" owned by this app. Required by
         Play AAOS review for navigation apps (developer.android.com/training/cars/apps/library/draw-maps). -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- AltVideo (USB 0x2C) IPC permission. Protects NaviVideoSourceService so only
         co-signed priv-apps (ClusterHomeDisplay) can bind and consume the stream.
         signature|privileged: callers may qualify through our signing certificate
         OR privileged permission assignment. uses-permission is required because the service-protecting
         permission is declared and used by the same app. -->
    <permission
        android:name="com.carlink.permission.NAVI_VIDEO_STREAM"
        android:protectionLevel="signature|privileged" />
    <uses-permission android:name="com.carlink.permission.NAVI_VIDEO_STREAM" />

    <!-- USB Host. required=false on purpose: the CPC200 adapter needs USB host at
         runtime, but GM AAOS (gm/gminfo37) does NOT advertise android.hardware.usb.host
         in its Play device profile, so required=true filtered the truck out of the AAOS
         track. required=false stops Play filtering on it; the UsbManager API + the
         usb_device_filter below are unaffected and still work at runtime. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Optional Features -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- AAOS-only distribution per developer.android.com/training/cars/distribute:
         media apps on the Android Automotive OS Play track must declare
         android.hardware.type.automotive as required=true (or unset). Setting it false
         would let the same APK install on phones/tablets where the AAOS-specific
         services have no host. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="${automotiveFeatureRequired}" />
    <!-- Car App Library Templates Host. The cluster CarAppService is bound and
         surface-provisioned by com.google.android.apps.automotive.templates.host
         (live-verified on the AAOS emulator: renderer_service holds an open
         ConnectionRecord to CabinClusterService). Declared required per Play AAOS
         review; every certified AAOS build — including GM — ships the Templates Host. -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="${templatesHostFeatureRequired}" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- TEYES TPRO's exported vehicle-data service. Package visibility is scoped;
         no broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.syu.ms" />
        <package android:name="com.syu.carlink" />
    </queries>

    <application
        android:name="com.cabin.telemetry.CabinApplication"
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CabinNative"
        tools:targetApi="35">
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <service android:name="com.cabin.platform.CabinMediaListener"
            android:exported="true" android:label="@string/tools_media_access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>


        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:resizeableActivity="true"
            android:theme="@style/Theme.CabinNative.Fullscreen"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Separate CAR_MODE filter for automotive launchers -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_MODE" />
            </intent-filter>

            <!-- AAOS Media App Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!-- USB Device Attachment -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />

            <!-- AAOS Distraction Optimization for Activity -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <activity-alias
            android:name="com.carlink.launcher.CarlinkHome"
            android:targetActivity="com.cabin.MainActivity"
            android:exported="true"
            android:label="@string/launcher_entry_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Keep existing pinned app shortcuts working across the namespace rename. -->
        <activity-alias
            android:name="com.carlink.MainActivity"
            android:targetActivity="com.cabin.MainActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <!-- Optional launcher widget. AAOS launchers that implement AppWidgetHost can
             surface it; launchers without widget hosting simply ignore this receiver.
             RemoteViews cannot host video, so tapping it opens the same MainActivity
             SurfaceView in a compact panel over the launcher. -->
        <receiver
            android:name=".widget.CabinWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cabin_widget_info" />
        </receiver>

        <!-- Widget-triggered headless projection owner. It immediately promotes itself
             to a connected-device foreground service, keeps USB/audio/media alive with
             no Activity, and shares its live CabinManager when MainActivity opens. -->
        <service
            android:name=".background.CabinProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location|microphone" />

        <service
            android:name=".joying.JoyingCarPlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|connectedDevice" />

        <!-- Media3 MediaLibraryService for AAOS Integration.
             Dual intent-filter: the modern `androidx.media3.session.MediaLibraryService`
             action for Media3-aware controllers, and the legacy
             `android.media.browse.MediaBrowserService` action for AAOS Media Center and
             other MediaBrowserCompat clients. Per Media3 migration guide
             (developer.android.com/media/media3/exoplayer/migration-guide),
             MediaLibraryService is backwards-compatible with legacy MediaBrowserCompat
             clients, so declaring both actions covers both controller generations. -->
        <service
            android:name=".media.CabinMediaBrowserService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback|connectedDevice"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- AAOS CarLauncher opt-in. Required because cabin is BOTH a launcher
                 app and an MBS: MediaSource.isMediaTemplate() classifies dual-role
                 apps as "non media template" unless this explicit opt-in is present.
                 Without it the homescreen Media card hides cabin, and any source
                 re-election after a force-close fails to promote zeno.carlink (which
                 in turn leaves ClusterHome with nothing to mirror). -->
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />
            <!-- GM Homescreen: Hide from launcher while keeping service functional -->
            <meta-data
                android:name="com.gm.homescreen.visibility"
                android:value="HIDDEN" />
        </service>

        <!-- Cluster Navigation CarAppService (headless — no UI on main display) -->
        <service
            android:name=".cluster.CabinClusterService"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
            <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="6" />
            <meta-data android:name="com.gm.homescreen.visibility" android:value="HIDDEN" />
        </service>

        <!-- AltVideo (USB 0x2C) producer Service. ClusterHomeDisplay binds to
             ComponentName("zeno.carlink", "zeno.carlink.ipc.NaviVideoSourceService"),
             so the class FQN must be the applicationId-prefixed form (NOT the
             namespace-prefixed .ipc.NaviVideoSourceService shorthand). The class
             lives at app/src/main/kotlin/zeno/carlink/ipc/NaviVideoSourceService.kt
             to match.

             Service is exported and present in all builds; it is inert on release
             APKs and on real devices because the gate in CabinManager prevents
             naviScreenInfo from being sent — without that, the adapter never emits
             0x2C and no consumer binds. Cost of leaving it exported on prod: zero. -->
        <service
            android:name="zeno.carlink.ipc.NaviVideoSourceService"
            android:exported="true"
            android:permission="com.carlink.permission.NAVI_VIDEO_STREAM" />

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!-- Tintable monochrome icon used by AAOS Media Center / system UI on media
             cards. Per developer.android.com/training/cars/media/configure-manifest. -->
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_cabin_attribution" />

        <!-- Required at application level — Templates Host reads minCarApiLevel
             from application metadata, not from service element -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="6" />

        <!-- APPLICATION-LEVEL DISTRACTION OPTIMIZATION DECLARATION -->
        <meta-data
            android:name="com.android.automotive.application.DISTRACTION_OPTIMIZED"
            android:value="true" />

        <!-- Retain Cabin's existing private cluster-icon authority for upgrade compatibility.
             This does not claim the manufacturer Templates Host authority. -->
        <provider
            android:name=".provider.ClusterIconShimProvider"
            android:authorities="${clusterIconAuthority}"
            android:exported="true"
            android:grantUriPermissions="true"
            tools:ignore="ExportedContentProvider" />

        <!-- FileProvider for publishing album art as content:// URIs to AAOS media
             controllers (Media Center, cluster, system UI) IN ADDITION to the inline
             METADATA_KEY_ALBUM_ART Bitmap. URI path is additive only — the inline
             Bitmap is the primary renderer guarantee so that a missing/failed URI
             does not blank the Media Card.

             grantUriPermissions="true" enables this provider's URIs to be granted via
             Context.grantUriPermission(). Note (observation as of 2026-05-03 against
             Media3 1.10.0 source — re-verify on upgrade): a grep of all
             androidx.media3.session.* sources read on that date did not surface any
             grantUriPermission or FLAG_GRANT_READ_URI calls, suggesting Media3 does
             not auto-grant these URIs to bound MediaControllers in 1.10.0. The session
             appears to resolve artworkUri server-side via BitmapLoader.loadBitmapFromMetadata
             and ship a decoded Bitmap, so most controllers do not need URI access at
             all in this configuration. The few consumers that read URIs directly (GM
             RHMI cluster via its own ContentProvider chain, etc.) get permission from
             MediaSessionManager's grantUriToConsumers() — which is the mechanism
             observed to be doing the work for those consumers on the firmware tested. -->


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.albumart"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths_albumart" />
        </provider>

        <provider android:name="com.cabin.reports.ReportFileProvider" android:authorities="${applicationId}.reports" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths_reports" />
        </provider>
        <service android:name=".updates.UpdateJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <provider android:name=".updates.UpdateFileProvider" android:authorities="${applicationId}.updates"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths_updates" />
        </provider>
    </application>

</manifest>
